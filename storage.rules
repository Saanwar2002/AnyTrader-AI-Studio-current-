rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/admins/$(request.auth.uid))
      );
    }
    function isMutatingAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        (
          firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/admins/$(request.auth.uid)) &&
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/admins/$(request.auth.uid)).data.get('adminTier', 'super_admin') != 'support_readonly'
        )
      );
    }
    function isSafeImageMimeType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif|avif)');
    }
    function isValidImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && isSafeImageMimeType();
    }
    function isValidMedia() {
      return request.resource.size <= 25 * 1024 * 1024
        && (
          isSafeImageMimeType() ||
          request.resource.contentType.matches('audio/.*|video/.*|application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document')
        );
    }
    function isValidVideo() {
      return request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // --- Job Ownership & Participation Helpers (Bound to Named Production DB) ---
    function isJobOwnerInNamedDb(jobId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('homeownerId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('userId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('ownerId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('posterId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('customerId', '') == request.auth.uid
        );
    }

    function isJobOwnerById(jobId) {
      return isSignedIn() && (
        request.auth.uid == jobId ||
        isJobOwnerInNamedDb(jobId)
      );
    }

    function isJobTradespersonInNamedDb(jobId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('acceptedTradespersonId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('acceptedTraderId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('assignedTraderId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('tradespersonId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('traderId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('targetTradespersonId', '') == request.auth.uid
        );
    }

    function isJobTradespersonById(jobId) {
      return isSignedIn() && isJobTradespersonInNamedDb(jobId);
    }

    function isJobParticipant(jobId) {
      return isJobOwnerById(jobId) || isJobTradespersonById(jobId) || isAdmin();
    }

    function isJobParticipantWrite(jobId) {
      return isJobOwnerById(jobId) || isJobTradespersonById(jobId) || isMutatingAdmin();
    }

    // --- Property Ownership & Tenant Helpers (Bound to Named Production DB) ---
    function isPropertyOwnerOrManagerInNamedDb(propertyId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('ownerId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('userId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('homeownerId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('landlordId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('managerId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('propertyManagerId', '') == request.auth.uid
        );
    }

    function isPropertyTenantInNamedDb(propertyId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('tenantId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/properties/$(propertyId)).data.get('tenantIds', []).hasAny([request.auth.uid])
        );
    }

    function isPropertyOwnerOrAdmin(propertyId) {
      return isSignedIn() && (
        isPropertyOwnerOrManagerInNamedDb(propertyId) ||
        isAdmin()
      );
    }

    function isPropertyOwnerOrMutatingAdmin(propertyId) {
      return isSignedIn() && (
        isPropertyOwnerOrManagerInNamedDb(propertyId) ||
        isMutatingAdmin()
      );
    }

    function isPropertyTenantIssueParticipant(propertyId) {
      return isSignedIn() && (
        isPropertyOwnerOrManagerInNamedDb(propertyId) ||
        isPropertyTenantInNamedDb(propertyId) ||
        isAdmin()
      );
    }

    function isPropertyTenantIssueParticipantWrite(propertyId) {
      return isSignedIn() && (
        isPropertyOwnerOrManagerInNamedDb(propertyId) ||
        isPropertyTenantInNamedDb(propertyId) ||
        isMutatingAdmin()
      );
    }

    // --- Chat Participant Helper ---
    function isChatParticipantInNamedDb(conversationId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/conversations/$(conversationId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/conversations/$(conversationId)).data.get('participants', []).hasAny([request.auth.uid]) ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/conversations/$(conversationId)).data.get('participantIds', []).hasAny([request.auth.uid])
        );
    }

    function isChatParticipant(conversationId) {
      return isSignedIn() && (
        isChatParticipantInNamedDb(conversationId) ||
        isAdmin()
      );
    }

    function isChatParticipantWrite(conversationId) {
      return isSignedIn() && (
        isChatParticipantInNamedDb(conversationId) ||
        isMutatingAdmin()
      );
    }

    // --- Dispute Participant Helper ---
    function isDisputeParticipantInNamedDb(jobId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('homeownerId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('userId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('customerUid', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('assignedTraderId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('acceptedTradespersonId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/jobs/$(jobId)).data.get('traderId', '') == request.auth.uid
        );
    }

    function isDisputeParticipant(jobId) {
      return isSignedIn() && (
        isDisputeParticipantInNamedDb(jobId) ||
        isAdmin()
      );
    }

    function isDisputeParticipantWrite(jobId) {
      return isSignedIn() && (
        isDisputeParticipantInNamedDb(jobId) ||
        isMutatingAdmin()
      );
    }

    // --- Ride Participant Helper ---
    function isRideParticipantInNamedDb(rideId) {
      return (
        (
          firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/rides/$(rideId)) &&
          (
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/rides/$(rideId)).data.get('passengerId', '') == request.auth.uid ||
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/rides/$(rideId)).data.get('riderId', '') == request.auth.uid ||
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/rides/$(rideId)).data.get('driverId', '') == request.auth.uid ||
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/rides/$(rideId)).data.get('assignedDriverId', '') == request.auth.uid
          )
        ) ||
        (
          firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/ride_requests/$(rideId)) &&
          (
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/ride_requests/$(rideId)).data.get('passengerId', '') == request.auth.uid ||
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/ride_requests/$(rideId)).data.get('riderId', '') == request.auth.uid ||
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/ride_requests/$(rideId)).data.get('driverId', '') == request.auth.uid ||
            firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/ride_requests/$(rideId)).data.get('assignedDriverId', '') == request.auth.uid
          )
        )
      );
    }

    function isRideParticipant(rideId) {
      return isSignedIn() && (
        isAdmin() ||
        isRideParticipantInNamedDb(rideId)
      );
    }

    function isRideParticipantWrite(rideId) {
      return isSignedIn() && (
        isMutatingAdmin() ||
        isRideParticipantInNamedDb(rideId)
      );
    }

    // --- Vehicle Participant Helper ---
    function isVehicleParticipantInNamedDb(vehicleId) {
      return firestore.exists(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/vehicles/$(vehicleId)) &&
        (
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/vehicles/$(vehicleId)).data.get('driverId', '') == request.auth.uid ||
          firestore.get(/databases/ai-studio-anytrader-44dab8b3-bbc9-4352-b725-2cbe7a1dfd2a/documents/vehicles/$(vehicleId)).data.get('ownerId', '') == request.auth.uid
        );
    }

    function isVehicleParticipant(vehicleId) {
      return isSignedIn() && (
        isVehicleParticipantInNamedDb(vehicleId) ||
        isAdmin()
      );
    }

    function isVehicleParticipantWrite(vehicleId) {
      return isSignedIn() && (
        isVehicleParticipantInNamedDb(vehicleId) ||
        isMutatingAdmin()
      );
    }

    // ==========================================
    // STORAGE PATH MATCHING RULES
    // ==========================================

    // 1. Private Job Media (Before/After photos, specs, drawings, voice notes, PDFs, attachments)
    // Recursive matching {allPaths=**} protects all nested subdirectories
    match /jobs/{jobId}/{allPaths=**} {
      allow read: if isJobParticipant(jobId);
      allow write: if isJobParticipantWrite(jobId) && isValidMedia();
    }

    // 2. Public Job Media: Explicit separate derivative area for published marketplace showcases
    match /public_job_media/{jobId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (isJobOwnerById(jobId) || isMutatingAdmin()) && isValidMedia();
    }

    // 3. Property Media (Private Passport docs, EPC, CP12/EICR, condition photos)
    // Restricted strictly to property owners, landlords, assigned managers, and admins.
    // Tenants are confined strictly to tenant-issue evidence subpaths.
    match /properties/{propertyId}/tenant-issues/{allPaths=**} {
      allow read: if isPropertyTenantIssueParticipant(propertyId);
      allow write: if isPropertyTenantIssueParticipantWrite(propertyId) && isValidMedia();
    }
    match /properties/{propertyId}/tenant_issues/{allPaths=**} {
      allow read: if isPropertyTenantIssueParticipant(propertyId);
      allow write: if isPropertyTenantIssueParticipantWrite(propertyId) && isValidMedia();
    }
    match /properties/{propertyId}/{allPaths=**} {
      allow read: if isPropertyOwnerOrAdmin(propertyId);
      allow write: if isPropertyOwnerOrMutatingAdmin(propertyId) && isValidMedia();
    }

    // 4. Public User Profiles (Public Avatars, Portfolio showcase items)
    match /users/{uid}/public/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) || isMutatingAdmin()) && isValidMedia();
    }
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) || isMutatingAdmin()) && isValidImage();
    }
    match /portfolio/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(uid) || isMutatingAdmin()) && isValidMedia();
    }

    // 5. Private User Verification (KYC documents, ID cards, insurance policies, video verification)
    match /users/{uid}/private/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isMutatingAdmin()) && isValidMedia();
    }
    match /verifications/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isMutatingAdmin()) && isValidMedia();
    }
    match /users/{uid}/video_verification/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isMutatingAdmin()) && isValidVideo();
    }

    // 6. Chat Attachments (Images, voice notes, files)
    match /chats/{conversationId}/{allPaths=**} {
      allow read: if isChatParticipant(conversationId);
      allow write: if isChatParticipantWrite(conversationId) && isValidMedia();
    }

    // 7. Disputes and Resolution Evidence
    match /disputes/{jobId}/{allPaths=**} {
      allow read: if isDisputeParticipant(jobId);
      allow write: if isDisputeParticipantWrite(jobId) && isValidMedia();
    }

    // 8. Rides Portal (Chat attachments & trip receipts)
    match /rides/{rideId}/{allPaths=**} {
      allow read: if isRideParticipant(rideId);
      allow write: if isRideParticipantWrite(rideId) && isValidMedia();
    }

    // 9. Vehicles and Driver Compliance Documents
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if isVehicleParticipant(vehicleId);
      allow write: if isVehicleParticipantWrite(vehicleId) && isValidMedia();
    }

    // 10. V8.1 Structured Intelligence Raw Storage (Tier B)
    // Server/Admin SDK writes directly. Client reads and writes are DENIED.
    match /intelligence_raw/{aggregateId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isMutatingAdmin();
    }

    // 10b. V8.1 Structured Intelligence Evidence Storage
    // Server/Admin SDK writes directly. Client reads and writes are DENIED.
    match /intelligence_evidence/{evidenceId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isMutatingAdmin();
    }

    // 11. Default Deny on all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

